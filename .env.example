# Supabase Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Database Connections (Dev & Prod Supabase projects / Hyperdrive)
DEV_DATABASE_URL=
PROD_DATABASE_URL=
DATABASE_URL=

# Wrangler reads this from the shell when emulating Hyperdrive locally.
WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

# Server Configuration
# 32-byte Base64 master key for AES-GCM credential vault. Lives only in deployment secrets or .dev.vars.
# Generate with: openssl rand -base64 32
VAULT_ENCRYPTION_KEY=
