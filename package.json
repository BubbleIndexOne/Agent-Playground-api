{
  "name": "agent-playground-backend",
  "version": "1.0.0",
  "description": "Agent Playground Backend API Service (Milestone S1)",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle.js",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:prod": "node dist/main.js",
    "dev": "npm run start:dev",
    "migrate": "node scripts/migrate.js",
    "migrate:dev": "node scripts/migrate.js dev",
    "migrate:prod": "node scripts/migrate.js prod"
  },
  "dependencies": {
    "@codegenie/serverless-express": "^4.17.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@supabase/supabase-js": "^2.48.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
